-- glslfx version 0.1
-- configuration
{
    "metadata": {"materialTag": "translucent"},
    "parameters": {
        "rulerResolution": {"default": [1280.0, 720.0]},
        "rulerGhost": {"default": 0.0},
        "rulerOpacity": {"default": 1.0},
        "rulerMask": {"default": 1.0}
    },
    "attributes": {
        "rulerOther": {"type": "vec3"},
        "rulerOffset": {"type": "vec2"},
        "rulerKind": {"type": "float"},
        "rulerColor": {"type": "vec3"},
        "rulerThickness": {"type": "float"},
        "rulerStart": {"type": "vec3"},
        "rulerEnd": {"type": "vec3"},
        "rulerUv": {"type": "vec2"}
    },
    "techniques": {"default": {
        "surfaceShader": {"source": ["Ruler.Surface"]},
        "displacementShader": {"source": ["Ruler.Displacement"]}
    }}
}
-- glsl Ruler.Surface
vec4 surfaceShader(vec4 Peye, vec3 Neye, vec4 color, vec4 patchCoord)
{
    float mask;
    if (HdGet_rulerKind() > 0.5) {
        mask = HdGet_rulerMask();
    } else {
        // Measure coverage in pixels; interpolated UVs distort long perspective lines.
        mat4 worldToClip = GetProjectionMatrix() * GetWorldToViewMatrix();
        vec4 start = worldToClip * vec4(HdGet_rulerStart(), 1.0);
        vec4 end = worldToClip * vec4(HdGet_rulerEnd(), 1.0);
        float firstDistance = start.z + start.w;
        float secondDistance = end.z + end.w;
        if (firstDistance <= 0.0 && secondDistance <= 0.0) discard;
        if (firstDistance <= 0.0)
            start = mix(start, end, -firstDistance / (secondDistance - firstDistance));
        else if (secondDistance <= 0.0)
            end = mix(start, end, firstDistance / (firstDistance - secondDistance));
        vec2 resolution = max(HdGet_rulerResolution(), vec2(1.0));
        vec2 a = (start.xy / start.w * 0.5 + 0.5) * resolution;
        vec2 b = (end.xy / end.w * 0.5 + 0.5) * resolution;
        vec2 direction = b - a;
        float magnitude = length(direction);
        if (magnitude < 1e-6) discard;
        vec2 delta = gl_FragCoord.xy - a;
        float distance = abs(delta.x * direction.y - delta.y * direction.x) / magnitude;
        float halfWidth = HdGet_rulerThickness() * 0.5;
        mask = 1.0 - smoothstep(halfWidth - 0.5, halfWidth + 0.5, distance);
    }
    if (mask < 0.01) discard;
    float opacity = mask * HdGet_rulerOpacity();
    return vec4(HdGet_rulerColor() * opacity, opacity);
}
-- glsl Ruler.Displacement
vec4 displacementShader(int index, vec4 Peye, vec3 Neye, vec4 patchCoord)
{
    mat4 projection = GetProjectionMatrix();
    vec4 clip = projection * Peye;
    vec2 offset = HdGet_rulerOffset(index);
    vec2 resolution = max(HdGet_rulerResolution(), vec2(1.0));
    if (HdGet_rulerKind(index) < 0.5) {
        vec4 other = projection * GetWorldToViewMatrix() * vec4(HdGet_rulerOther(index), 1.0);
        // Clip long world axes at the camera's near plane before expanding the line.
        float firstDistance = clip.z + clip.w;
        float secondDistance = other.z + other.w;
        if (firstDistance <= 0.0 && secondDistance <= 0.0)
            return inverse(projection) * vec4(2.0, 2.0, 2.0, 1.0);
        if (firstDistance <= 0.0)
            clip = mix(clip, other, -firstDistance / (secondDistance - firstDistance));
        else if (secondDistance <= 0.0)
            other = mix(clip, other, firstDistance / (firstDistance - secondDistance));
        vec2 tangent = (other.xy / other.w - clip.xy / clip.w) * resolution;
        float magnitude = length(tangent);
        if (magnitude > 1e-8)
            clip.xy += vec2(-tangent.y, tangent.x) / magnitude * offset.x * offset.y / resolution * clip.w;
    } else {
        // An axis viewed end-on has no readable tick separation.
        vec3 direction = mat3(GetWorldToViewMatrix()) * HdGet_rulerOther(index);
        if (length(direction.xy) < 0.02)
            return inverse(projection) * vec4(2.0, 2.0, 2.0, 1.0);
        if (clip.z + clip.w <= 0.0)
            return inverse(projection) * vec4(2.0, 2.0, 2.0, 1.0);
        clip.xy += offset * 2.0 / resolution * clip.w;
    }
    // A faint foreground pass survives occlusion; the full-strength pass keeps world depth.
    if (HdGet_rulerGhost() > 0.5) clip.z = -clip.w * 0.9999;
    else clip.z -= clip.w * 0.000001;
    return inverse(projection) * clip;
}
