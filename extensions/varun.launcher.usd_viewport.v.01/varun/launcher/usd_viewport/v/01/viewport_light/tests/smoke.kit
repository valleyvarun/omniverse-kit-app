# ----------------------------------------------------------------------
# 1. PACKAGE DETAILS
# ----------------------------------------------------------------------

[package]
title = "Viewport Light integration test"
version = "1.0.0"

# ----------------------------------------------------------------------
# 2. EXTENSION DEPENDENCIES
# ----------------------------------------------------------------------

[dependencies]
"varun.launcher.usd_viewport.v.01" = {}
"omni.kit.renderer.capture" = {}
"omni.kit.menu.create" = {}

# ----------------------------------------------------------------------
# 3. DEFAULT SETTINGS
# ----------------------------------------------------------------------

[settings]
app.window.width = 1200
app.window.height = 800
app.window.title = "Viewport Light validation"
app.settings.persistent = false
app.settings.loadUserConfig = false
app.settings.saveUserConfig = false
app.exts.registryEnabled = false
app.exts.autoUpdate = false
app.content.emptyStageOnStart = false
app.fastShutdown = true
exts."omni.kit.viewport.ready".startup.enabled = false
