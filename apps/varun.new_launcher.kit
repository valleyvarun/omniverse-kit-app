[package]
title = "varun_new_launcher"
version = "0.1.0"
description = """A clean slate launcher application."""
keywords = ["app"]  # That makes it browsable in UI with "app" filter


[dependencies]
"omni.kit.uiapp" = {}  # Base UI application
"omni.kit.mainwindow" = {}  # Main window that hosts the menu bar
"omni.kit.menu.utils" = {}  # Menu bar framework
"omni.kit.menu.file" = {}  # File menu
"omni.kit.menu.edit" = {}  # Edit menu
"varun.launcher.layout.v.01" = {}  # Launcher window layout
"varun.launcher.custom_menu.v.01" = {}  # Custom application menus
"varun.launcher.workspace.v.01" = {}  # Workspace tabs bar
"varun.launcher.home.v.01" = {}  # Home page
"varun.launcher.usd_viewport.v.01" = {}  # Floating USD viewport


[settings.app]
font.file = "${fonts}/OpenSans-SemiBold.ttf"
font.size = 18
window.title = "varun_new_launcher"


[settings.app.launcher.layout]
tabs_window = "tabs_bar_window"


[settings.app.exts]
folders.'++' = [  # Search paths for extensions.
	"${app}/../exts",
	"${app}/../extscache/"
]


[template]
type = "ApplicationTemplate" # Repo Template Metadata



# Kit SDK Version: 109.0.3+production.263267.62477c11.gl

# Version lock for all dependencies:
[settings.app.exts]
enabled = [
]
